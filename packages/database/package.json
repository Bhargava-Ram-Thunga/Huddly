    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "^6.4.1"
  }
}
