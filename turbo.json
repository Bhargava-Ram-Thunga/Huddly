{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^db:generate", "db:generate", "^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate", "^build"]
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate", "^build"]
    },
    "test:coverage": {
      "dependsOn": ["^db:generate", "db:generate", "^build"],
      "outputs": ["coverage/**"]
    }
  }
}
