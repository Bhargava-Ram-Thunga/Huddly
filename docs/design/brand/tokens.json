{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Huddly Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "butter": {
        "hex": "#F2BB31",
        "oklch": "oklch(0.80 0.17 85.0)",
        "description": "Primary brand accent, energetic and warm, representing play and synchronization."
      },
      "caramel": {
        "hex": "#BF7118",
        "oklch": "oklch(0.58 0.16 60.0)",
        "description": "Secondary accent, focus states, and warm borders."
      },
      "boxred": {
        "hex": "#D94543",
        "oklch": "oklch(0.58 0.20 25.0)",
        "description": "Critical alerts, errors, recording indicators, and popcorn box red."
      },
      "kernel": {
        "hex": "#4D3119",
        "oklch": "oklch(0.32 0.08 55.0)",
        "description": "Deep warm shadow and high-contrast text on butter."
      },
      "cream": {
        "hex": "#FAF3E4",
        "oklch": "oklch(0.96 0.02 85.0)",
        "description": "Primary background in light mode, primary text in dark mode."
      },
      "cinema": {
        "hex": "#131A2A",
        "oklch": "oklch(0.20 0.04 260.0)",
        "description": "Primary background in dark mode, primary text in light mode."
      }
    },
    "semantic": {
      "light": {
        "background": {
          "primary": "#FAF3E4",
          "secondary": "#F3EBD8",
          "tertiary": "#EADBBE",
          "overlay": "rgba(19, 26, 42, 0.6)"
        },
        "foreground": {
          "primary": "#131A2A",
          "secondary": "#4D3119",
          "muted": "#755E49",
          "inverse": "#FAF3E4"
        },
        "border": {
          "subtle": "#E5D7BF",
          "default": "#D1C0A5",
          "focus": "#BF7118"
        },
        "status": {
          "success": "#2E8540",
          "warning": "#BF7118",
          "error": "#D94543",
          "info": "#1E70B8"
        }
      },
      "dark": {
        "background": {
          "primary": "#131A2A",
          "secondary": "#1B2438",
          "tertiary": "#24304A",
          "overlay": "rgba(8, 11, 18, 0.75)"
        },
        "foreground": {
          "primary": "#FAF3E4",
          "secondary": "#E5D7BF",
          "muted": "#96A4B8",
          "inverse": "#131A2A"
        },
        "border": {
          "subtle": "#253147",
          "default": "#364563",
          "focus": "#F2BB31"
        },
        "status": {
          "success": "#4CAF50",
          "warning": "#F2BB31",
          "error": "#D94543",
          "info": "#4DA1E8"
        }
      }
    },
    "participants": {
      "algorithm": "golden_angle",
      "baseHue": 85,
      "goldenAngle": 137.507764,
      "formula": "hue(n) = (85 + n * 137.507764) mod 360",
      "light": {
        "lightness": 0.74,
        "chroma": 0.155,
        "template": "oklch(0.74 0.155 {hue})"
      },
      "dark": {
        "lightness": 0.8,
        "chroma": 0.145,
        "template": "oklch(0.80 0.145 {hue})"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "none": 1,
      "tight": 1.25,
      "snug": 1.375,
      "normal": 1.5,
      "relaxed": 1.625
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  }
}
